---
eleventyNavigation:
  key: "reading-genre-{{ genreData.genre }}"
  title: "{{ genreData.genre }}"
  parent: reading-genres
eleventyComputed:
  title: "{{ genreData.genre }} | Reading"
pagination:
  data: collections.booksByGenre
  size: 1
  alias: genreData
permalink: "/reading/genres/{{ genreData.genre | slugify }}/"
excludeFromSitemap: true
---
<header class="main-header">
  {% include "partials/breadcrumb.njk" %}
  <h1>{{ genreData.genre }}</h1>
</header>
<section>
  <header>
    <h2 class="title">{{ genreData.books.length }} book{{ 's' if genreData.books.length !== 1 }}</h2>
  </header>
  <ul role="list" class="collection__grid">
    {% set sortedBooks = genreData.books | sort(attribute='author') %}
    {% for book in sortedBooks %}
    <li>
      <a href="/reading/works/{{ book.title | slugify }}-{{ book.author | slugify }}"
        class="collection__item surface">
        <img
          src="../img/{{ book.title | slugify }}-{{ book.author | slugify }}.jpg"
          alt="{{ book.title }}"
          class="collection__image">
        <div class="collection__details">
          <h2 class="title">{{ book.title }}</h2>
          <p class="meta">{{ book.author }}</p>
          {% if book.favourite %}
          <div class="badge"><svg width="14" height="14" viewBox="0 0 24 24" class="icon-stroke" aria-hidden="true">
            <use xlink:href="#icon-heart"></use>
          </svg> Favourite</div>
          {% endif %}
        </div>
        <svg width="36" height="36" viewBox="-6 -6 36 36" class="collection__action action icon-stroke"
          aria-hidden="true">
          <use xlink:href="#icon-chevron-right"></use>
        </svg>
      </a>
    </li>
    {% endfor %}
  </ul>
</section>
